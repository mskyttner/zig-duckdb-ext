# name: test/sql/zig_ext.test
# description: Parity test for zig_ext scalar functions
# group: [zig_ext]

statement ok
SET allow_extensions_metadata_mismatch=true

statement error
SELECT zig_add_numbers(1, 2)
----
Catalog Error: Scalar Function with name zig_add_numbers does not exist!

require zig_ext

query I
SELECT zig_add_numbers(1, 2)
----
3

query I
SELECT zig_add_numbers(NULL, 2)
----
NULL

query I
SELECT tp_bar(0.5, "on" := 'X', "off" := '.', width := 10)
----
XXXXX.....

# ── Ported from the former test:e2e/smoke.sql (task test:e2e) ──────────────
# That task only checked exit code (did the query error?), never the actual
# output — these blocks are a strictly stronger replacement, verifying exact
# values via the native sqllogictest runner. Multi-column table-function
# results are split into one single-column query per column: this runner
# supports one value per line, not tab-separated rows (see
# src/sqllogictest_main.zig's own doc comment on what it doesn't support).
# An expected empty-string result is wrapped in brackets (`'[' || x || ']'`)
# for the same reason — a literal empty line can't be told apart from "no
# row" by this runner's line-based matching.

# ── zig_hello ────────────────────────────────────────────────────────────

query T
SELECT zig_hello('Zig')
----
"Hello, Zig!"

query T
SELECT zig_hello('')
----
"Hello, !"

query T
SELECT zig_hello(NULL)
----
NULL

# ── zig_add_numbers (additional cases) ──────────────────────────────────

query I
SELECT zig_add_numbers(100, -50)
----
50

query I
SELECT zig_add_numbers(0, 0)
----
0

query I
SELECT zig_add_numbers(i, i * 10) FROM generate_series(1, 5) t(i)
----
11
22
33
44
55

# ── zig_tokenize ─────────────────────────────────────────────────────────

query I
SELECT token_pos FROM zig_tokenize('alice,bob,charlie', ',')
----
0
1
2

query T
SELECT token FROM zig_tokenize('alice,bob,charlie', ',')
----
alice
bob
charlie

query T
SELECT token FROM zig_tokenize('one::two::three', '::')
----
one
two
three

query T
SELECT '[' || token || ']' FROM zig_tokenize('a,b,', ',')
----
[a]
[b]
[]

query T
SELECT '[' || token || ']' FROM zig_tokenize(',a,b', ',')
----
[]
[a]
[b]

query T
SELECT '[' || token || ']' FROM zig_tokenize('a,,b', ',')
----
[a]
[]
[b]

query T
SELECT token FROM zig_tokenize('hello world', ',')
----
hello world

query T
SELECT '[' || token || ']' FROM zig_tokenize('', ',')
----
[]

query T
SELECT token FROM zig_tokenize('hello', '')
----
hello

query I
SELECT token_pos FROM zig_tokenize('the,quick,brown,fox', ',') WHERE length(token) > 3
----
1
2

query T
SELECT token FROM zig_tokenize('the,quick,brown,fox', ',') WHERE length(token) > 3
----
quick
brown

# ── ct_add_numbers (comptime scalar) ────────────────────────────────────

query I
SELECT ct_add_numbers(2, 3)
----
5

query I
SELECT ct_add_numbers(100, -50)
----
50

query I
SELECT ct_add_numbers(0, 0)
----
0

query I
SELECT ct_add_numbers(NULL, 5)
----
NULL

query I
SELECT ct_add_numbers(5, NULL)
----
NULL

query I
SELECT ct_add_numbers(i, i * 10) FROM generate_series(1, 5) t(i)
----
11
22
33
44
55

query T
SELECT match FROM (SELECT ct_add_numbers(i, i * 10) = zig_add_numbers(i, i * 10) AS match FROM generate_series(1, 100) t(i) GROUP BY match) x
----
true

# ── ct_tokenize (comptime table function) ───────────────────────────────

query I
SELECT token_pos FROM ct_tokenize('alice,bob,charlie', ',')
----
0
1
2

query T
SELECT token FROM ct_tokenize('alice,bob,charlie', ',')
----
alice
bob
charlie

query T
SELECT token FROM ct_tokenize('one::two::three', '::')
----
one
two
three

query T
SELECT '[' || token || ']' FROM ct_tokenize('a,b,', ',')
----
[a]
[b]
[]

query T
SELECT token FROM ct_tokenize('hello world', ',')
----
hello world

query T
SELECT match FROM (SELECT ct.token_pos = hw.token_pos AND ct.token = hw.token AS match FROM ct_tokenize('the,quick,brown,fox', ',') ct JOIN zig_tokenize('the,quick,brown,fox', ',') hw ON ct.token_pos = hw.token_pos GROUP BY match) x
----
true

# ── tp_bar (additional cases) ────────────────────────────────────────────

query T
SELECT tp_bar_impl(0.7, '█', '░', 15)
----
"███████████░░░░"

query T
SELECT tp_bar(0.0, "on" := 'X', "off" := '.', width := 5)
----
.....

query T
SELECT tp_bar(1.0, "on" := 'X', "off" := '.', width := 5)
----
XXXXX

query T
SELECT tp_bar(0.5)
----
"████████░░░░░░░"

query T
SELECT tp_bar(NULL, "on" := 'X', "off" := '.', width := 5)
----
NULL

query T
SELECT tp_bar(i * 0.1, "on" := '#', "off" := '-', width := 10) FROM generate_series(0, 10) t(i)
----
----------
#---------
##--------
###-------
####------
#####-----
######----
#######---
########--
#########-
##########

# ── tp_line / tp_snakemap ────────────────────────────────────────────────
# Both render multi-row ASCII/ANSI art (embedded newlines, ANSI escapes for
# tp_snakemap), which this line-oriented runner can't represent directly as
# a single expected value (see src/sqllogictest_main.zig's doc comment on
# unsupported forms — no CSV-quote-aware multi-line field handling). Rather
# than settle for an "at least it didn't error" check (weaker than what
# `task test:e2e` gave, since that only means `statement ok`, which itself
# requires NO result rows at all and so can't even be used for a `SELECT`
# that returns a value), `md5(...)` collapses the whole rendered output to
# one deterministic hex string on one line — a real exact-match check, not
# a weaker substitute: any pixel of the rendered chart changing changes the
# hash. (Switching the runner to `-json` mode, which escapes embedded
# newlines as `\n`, would let these show the literal expected text instead
# of an opaque hash — a readability improvement, not a coverage one; not
# attempted here.)

query T
SELECT tp_line(NULL)
----
NULL

query T
SELECT '[' || tp_line([]::DOUBLE[]) || ']'
----
[]

query T
SELECT md5(tp_line([1.0, 2.0, 4.0, 3.0, 5.0, 2.0, 3.0]))
----
5fc727f7b189609027f3a30dfd0450f6

query T
SELECT md5(tp_line([0.0, 1.0, 0.0, -1.0, 0.0]))
----
0242dc02d4db81949882c35e0d75a20c

query T
SELECT md5(tp_line([1.0, 3.0, 2.0, 4.0, 1.0], height := 5.0))
----
f74d3ecdb5ad1ef048c65a77d054fa58

query T
SELECT md5(tp_line((SELECT list(v::DOUBLE ORDER BY i) FROM (VALUES (1, 1.0), (2, 3.0), (3, 2.0), (4, 4.0), (5, 1.0)) t(i, v))))
----
8104892cb9da835f391694aded5a8522

query T
SELECT tp_snakemap(NULL, ['a'], ['g'], width := 40, height := 20)
----
NULL

query T
SELECT md5(tp_snakemap([10.0, 20.0, 30.0, 5.0, 15.0, 25.0], ['a', 'b', 'c', 'x', 'y', 'z'], ['G1', 'G1', 'G1', 'G2', 'G2', 'G2'], width := 40, height := 20))
----
f881456020a2838d4a7505fd759c7a69

query T
SELECT md5(tp_snakemap([1.0, 2.0, 3.0, 4.0], ['p', 'q', 'r', 's'], ['Alpha', 'Alpha', 'Beta', 'Beta']))
----
fd86c25ba66e6f555690f5ee0722767e

query T
SELECT md5(tp_snakemap([10.0, 20.0, 30.0, 5.0, 15.0, 25.0], ['a', 'b', 'c', 'x', 'y', 'z'], ['G1', 'G1', 'G1', 'G2', 'G2', 'G2'], width := 40, height := 20, no_color := true))
----
7b19dc23dc3e8c300b4c24c5e3d9ab9b

query T
SELECT md5(tp_snakemap([5.0, 10.0, 15.0], ['small', 'medium', 'large'], ['only'], width := 40, height := 12))
----
8c884d52b5d8d0a35c61c9190fb264e3
