# The Arrow C Data Interface. zig_cookbook_arrow_export feeds DuckDB chunks to an exporter and reports the ArrowArrays
# that come out: what the structs say, and checksums that Zig computes from the raw Arrow buffers. The oracle is SQL.
query I
SELECT count(*) FROM zig_cookbook_arrow_export(2500)
----
9

query T
SELECT DISTINCT col || ':' || format || ':' || n_buffers FROM zig_cookbook_arrow_export(2500) ORDER BY 1
----
even:b:2
id:l:2
label:u:3

# 2500 rows in chunks of 2048 come out as arrays of 1000, 1000 and 500: the exporter holds rows back across chunks
# and the final flush finishes the last array.
query T
SELECT string_agg(length::VARCHAR, ',' ORDER BY batch) FROM zig_cookbook_arrow_export(2500) WHERE col = 'id'
----
1000,1000,500

# Per array: the sum of the ids, the bytes of the non-NULL labels (the offsets), the true booleans, and the NULLs.
query I
SELECT count(*) FROM (
    SELECT batch, col, length, null_count, checksum FROM zig_cookbook_arrow_export(2500)
    EXCEPT
    SELECT * FROM (
    SELECT i // 1000, 'id', count(*), 0, sum(i) FROM range(2500) t(i) GROUP BY 1
    UNION ALL
    SELECT i // 1000, 'label', count(*), count(*) FILTER (WHERE i % 3 = 0), sum(length('row-' || i)) FILTER (WHERE i % 3 <> 0) FROM range(2500) t(i) GROUP BY 1
    UNION ALL
    SELECT i // 1000, 'even', count(*), 0, count(*) FILTER (WHERE i % 2 = 0) FROM range(2500) t(i) GROUP BY 1
    )
)
----
0

query I
SELECT count(*) FROM zig_cookbook_arrow_export(0)
----
0

query I
SELECT count(*) FROM zig_cookbook_arrow_export(1)
----
3

statement error
SELECT * FROM zig_cookbook_arrow_export(-1)
----
n must be between 0 and 10000000, got -1

# zig_cookbook_arrow_import builds an ArrowSchema and ArrowArray by hand and gives them to an importer.
query T
SELECT column_name || ' ' || column_type FROM (DESCRIBE SELECT * FROM zig_cookbook_arrow_import(3))
----
id BIGINT
label VARCHAR
day DATE

statement ok
CREATE TABLE arrow_c_expected AS
SELECT (10 * i)::BIGINT AS id, CASE WHEN i % 4 = 3 THEN NULL ELSE 'item-' || i END AS label, DATE '1970-01-01' + i::INTEGER AS day
FROM range(2500) t(i)

# Zero-copy (the array is consumed) and copied, across chunk boundaries (batches of 1000 rows).
query I
SELECT count(*) FROM (SELECT * FROM zig_cookbook_arrow_import(2500) EXCEPT SELECT * FROM arrow_c_expected)
----
0

query I
SELECT count(*) FROM (SELECT * FROM arrow_c_expected EXCEPT SELECT * FROM zig_cookbook_arrow_import(2500))
----
0

query I
SELECT count(*) FROM (SELECT * FROM zig_cookbook_arrow_import(2500, copy := true) EXCEPT SELECT * FROM arrow_c_expected)
----
0

query I
SELECT count(*) FROM (SELECT * FROM arrow_c_expected EXCEPT SELECT * FROM zig_cookbook_arrow_import(2500, copy := true))
----
0

query III
SELECT count(*), count(label), max(id) FROM zig_cookbook_arrow_import(1001)
----
1001
751
10000

query T
SELECT label FROM zig_cookbook_arrow_import(8) ORDER BY id
----
item-0
item-1
item-2
NULL
item-4
item-5
item-6
NULL

query I
SELECT count(*) FROM zig_cookbook_arrow_import(0)
----
0

# Twice in one statement: two importers, two arrays, each released once.
query I
SELECT count(*) FROM zig_cookbook_arrow_import(3000) a JOIN zig_cookbook_arrow_import(3000, copy := true) b USING (id, label, day)
----
2250

query I
SELECT count(*) FROM (SELECT * FROM zig_cookbook_arrow_import(2000) UNION ALL SELECT * FROM zig_cookbook_arrow_import(2000, copy := true))
----
4000

statement error
SELECT * FROM zig_cookbook_arrow_import(10000001)
----
n must be between 0 and 10000000, got 10000001

# Every hand-built array was released exactly once, in both modes: none is left, and none was freed twice (a crash).
query I
SELECT live_arrays FROM zig_cookbook_arrow_live_arrays()
----
0

# While a statement still holds the chunks of a consumed array, the array is alive.
query I
SELECT max(live_arrays) FROM (SELECT live_arrays FROM zig_cookbook_arrow_live_arrays(), zig_cookbook_arrow_import(10) LIMIT 1)
----
1

# DuckDB's file system: zig_cookbook_fs_write and zig_cookbook_fs_read. The oracle is DuckDB's own read_blob.
query III
SELECT * FROM zig_cookbook_fs_write('/tmp/zig_ext_cookbook_fs.txt', 'hello world')
----
11
11
11

query I
SELECT count(*) FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs.txt') a, read_blob('/tmp/zig_ext_cookbook_fs.txt') b WHERE a.content = b.content AND a.size = b.size AND a.content = 'hello world'::BLOB
----
1

# create empties an existing file; append adds at the end.
query III
SELECT * FROM zig_cookbook_fs_write('/tmp/zig_ext_cookbook_fs.txt', 'hello', mode := 'create')
----
5
5
5

query III
SELECT * FROM zig_cookbook_fs_write('/tmp/zig_ext_cookbook_fs.txt', ' world', mode := 'append')
----
6
11
11

query IT
SELECT size, content::VARCHAR FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs.txt')
----
11
hello world

# A range is read at its offset: all of it, or an error.
query T
SELECT content::VARCHAR FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs.txt', 6, 5)
----
world

query T
SELECT content::VARCHAR FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs.txt', 6)
----
world

query T
SELECT content::VARCHAR FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs.txt', length := 5)
----
hello

query I
SELECT octet_length(content) FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs.txt', 3, 0)
----
0

statement error
SELECT * FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs.txt', 6, 100)
----
Could not read enough bytes

# The path goes through DuckDB's file system, not libc's: a file: URL is understood.
query T
SELECT content::VARCHAR FROM zig_cookbook_fs_read('file:///tmp/zig_ext_cookbook_fs.txt', 0, 5)
----
hello

# at: written at an offset, past the end if need be (the gap is zeros); the position does not move.
query III
SELECT * FROM zig_cookbook_fs_write('/tmp/zig_ext_cookbook_fs.txt', 'XY', mode := 'at', start := 14)
----
2
16
0

query T
SELECT hex(content) FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs.txt')
----
68656C6C6F20776F726C640000005859

# exclusive: a new file only. The path is new on every run.
query I
SELECT bytes FROM zig_cookbook_fs_write('/tmp/zig_ext_cookbook_fs_' || strftime(now(), '%Y%m%d%H%M%S%f') || '.txt', 'fresh', mode := 'exclusive')
----
5

statement error
SELECT * FROM zig_cookbook_fs_write('/tmp/zig_ext_cookbook_fs.txt', 'again', mode := 'exclusive')
----
File exists

# Empty content, and a file bigger than any buffer: written, then read back by the sequential loop.
query III
SELECT * FROM zig_cookbook_fs_write('/tmp/zig_ext_cookbook_fs_empty.txt', '')
----
0
0
0

query II
SELECT size, octet_length(content) FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs_empty.txt')
----
0
0

query III
SELECT * FROM zig_cookbook_fs_write('/tmp/zig_ext_cookbook_fs_big.txt', repeat('0123456789abcdef', 200000))
----
3200000
3200000
3200000

query I
SELECT count(*) FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs_big.txt') a, read_blob('/tmp/zig_ext_cookbook_fs_big.txt') b WHERE a.content = b.content AND a.size = 3200000
----
1

query T
SELECT content::VARCHAR FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs_big.txt', 1600000 + 10, 12)
----
abcdef012345

# Errors are DuckDB's own.
statement error
SELECT * FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs_does_not_exist')
----
No such file or directory

statement error
SELECT * FROM zig_cookbook_fs_write('/nonexistent_dir/x', 'x')
----
No such file or directory

statement error
SELECT * FROM zig_cookbook_fs_write('/tmp/zig_ext_cookbook_fs.txt', 'x', mode := 'truncate')
----
unknown mode 'truncate'

statement error
SELECT * FROM zig_cookbook_fs_write('/tmp/zig_ext_cookbook_fs.txt', 'x', mode := 'at', start := -1)
----
start must not be negative, got -1

statement error
SELECT * FROM zig_cookbook_fs_read('/tmp/zig_ext_cookbook_fs.txt', length := -2)
----
length must be -1 (to the end) or more, got -2

# Logging: zig_cookbook_log writes through context_log and returns its message. Whether an entry is recorded is up to
# the log configuration; the call itself always succeeds. The log is read back with duckdb_logs.
query T
SELECT zig_cookbook_log('info', 'zl_a', 'zl-not recorded: logging is off')
----
zl-not recorded: logging is off

# SET rather than CALL enable_logging: the CLI prints a warning when the call changes the log storage.
statement ok
SET logging_storage = 'memory'

statement ok
SET logging_level = 'debug'

statement ok
SET enable_logging = true

query T
SELECT string_agg(zig_cookbook_log(l, t, 'zl-' || l), ',' ORDER BY l) FROM (VALUES ('trace', 'zl_a'), ('debug', 'zl_a'), ('INFO', 'zl_b'), ('warning', ''), ('error', 'zl_a'), ('fatal', 'zl_a')) v(l, t)
----
zl-INFO,zl-debug,zl-error,zl-fatal,zl-trace,zl-warning

# Each entry carries its level, its type (empty is the default type) and the connection's ids. TRACE is below the
# threshold: the call succeeded and nothing was written.
query T
SELECT log_level || ':' || type || ':' || message FROM duckdb_logs WHERE message LIKE 'zl-%' ORDER BY message
----
INFO:zl_b:zl-INFO
DEBUG:zl_a:zl-debug
ERROR:zl_a:zl-error
FATAL:zl_a:zl-fatal
WARNING::zl-warning

query I
SELECT count(*) FROM duckdb_logs WHERE message = 'zl-not recorded: logging is off' OR message = 'zl-trace'
----
0

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'zl-%' AND (scope <> 'CONNECTION' OR connection_id IS NULL OR query_id IS NULL OR thread_id IS NOT NULL)
----
0

# Raising the threshold drops what is below it.
statement ok
CALL truncate_duckdb_logs()

statement ok
SET logging_level = 'warning'

query T
SELECT string_agg(zig_cookbook_log(l, 'zl_a', 'zl2-' || l), ',' ORDER BY l) FROM (VALUES ('debug'), ('info'), ('warning'), ('error')) v(l)
----
zl2-debug,zl2-error,zl2-info,zl2-warning

query T
SELECT string_agg(log_level, ',' ORDER BY log_level) FROM duckdb_logs WHERE message LIKE 'zl2-%'
----
ERROR,WARNING

# Not constant folded: a thousand equal calls are a thousand entries, all of one query.
statement ok
CALL truncate_duckdb_logs()

statement ok
SET logging_level = 'info'

query I
SELECT count(zig_cookbook_log('info', 'zl_a', 'zl3-same')) FROM range(1000)
----
1000

query II
SELECT count(*), count(DISTINCT query_id) FROM duckdb_logs WHERE message = 'zl3-same'
----
1000
1

# NULL in, NULL out, nothing logged.
query T
SELECT zig_cookbook_log('info', 'zl_a', NULL)
----
NULL

query T
SELECT zig_cookbook_log(NULL, 'zl_a', 'zl5-x')
----
NULL

query I
SELECT count(*) FROM duckdb_logs WHERE message = 'zl5-x'
----
0

statement error
SELECT zig_cookbook_log('loud', 'zl_a', 'zl6-x')
----
unknown level 'loud'

statement ok
SET enable_logging = false

query T
SELECT zig_cookbook_log('error', 'zl_a', 'zl7-off')
----
zl7-off

statement ok
SET enable_logging = true

query I
SELECT count(*) FROM duckdb_logs WHERE message = 'zl7-off'
----
0

statement ok
SET enable_logging = false
