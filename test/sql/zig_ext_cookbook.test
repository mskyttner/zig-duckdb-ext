# The codec really ran. LZ4 shrinks the repeating data to under half; the library's Zstd writer stores its blocks
# uncompressed (a valid frame, which PyArrow reads, but no smaller), so only the frame overhead tells it apart.
query T
SELECT (SELECT size FROM read_blob('/tmp/zig_ext_cookbook_arrow_lz4.arrows')) < (SELECT size FROM read_blob('/tmp/zig_ext_cookbook_arrow_none.arrows')) / 2 AND (SELECT size FROM read_blob('/tmp/zig_ext_cookbook_arrow_zstd.arrows')) > (SELECT size FROM read_blob('/tmp/zig_ext_cookbook_arrow_none.arrows'))
----
true

