# name: test/sql/zig_ext_cookbook.test
# description: The v2 cookbook extension, one section per example (see docs/cookbook.md)
# group: [zig_ext_cookbook]

statement ok
SET allow_extensions_metadata_mismatch=true

require zig_ext_cookbook

# ── Reading configuration: zig_cookbook_option / zig_cookbook_options (src/cookbook/config_options.zig) ──
# DuckDB's own current_setting() and duckdb_settings() are the oracle.

query T
SELECT zig_cookbook_option('threads') = current_setting('threads')::VARCHAR
----
true

# The connection's SET is what a function sees (a context reads the session's value).
statement ok
SET threads = 3

query T
SELECT zig_cookbook_option('threads')
----
3

statement ok
SET threads = 2

query T
SELECT zig_cookbook_option('threads')
----
2

# A string option, in the form DuckDB stores it.
statement ok
SET default_null_order = 'nulls_first'

query T
SELECT zig_cookbook_option('default_null_order')
----
NULLS_FIRST

# Names are case-insensitive, and an alias resolves to the option it stands for.
query T
SELECT zig_cookbook_option('DEFAULT_NULL_ORDER')
----
NULLS_FIRST

query T
SELECT zig_cookbook_option('wal_autocheckpoint') = zig_cookbook_option('checkpoint_threshold')
----
true

# Settings of other types, in the form current_setting() gives them (it needs a constant name, so one each).
query TT
SELECT zig_cookbook_option('memory_limit') = current_setting('memory_limit')::VARCHAR, zig_cookbook_option('enable_progress_bar') = current_setting('enable_progress_bar')::VARCHAR
----
true
true

# A NULL name gives NULL, on some rows of a column or on all.
query T
SELECT zig_cookbook_option(NULL) IS NULL
----
true

query I
SELECT count(zig_cookbook_option(CASE WHEN i % 3 = 0 THEN NULL ELSE 'threads' END)) FROM generate_series(1, 200) t(i)
----
134

# An unknown option is an error of the query, with DuckDB's reason.
statement error
SELECT zig_cookbook_option('no_such_option')
----
unknown configuration option: no_such_option

statement error
SELECT zig_cookbook_option(CASE WHEN i = 150 THEN 'no_such_option' ELSE 'threads' END) FROM generate_series(1, 200) t(i)
----
unknown configuration option: no_such_option

# The listing: aliases are not listed, each option once.
query T
SELECT count(*) > 100 AND count(DISTINCT name) = count(*) FROM zig_cookbook_options()
----
true

# Every listed option that duckdb_settings() also knows has the same description, and its setting is the
# one a function reads by name.
query I
SELECT count(*) FROM zig_cookbook_options() o JOIN duckdb_settings() s ON o.name = s.name WHERE o.description <> s.description
----
0

query T
SELECT count(*) > 100 FROM zig_cookbook_options() o JOIN duckdb_settings() s ON o.name = s.name
----
true

query T
SELECT bool_and(o.setting = zig_cookbook_option(o.name)) FROM zig_cookbook_options() o
----
true

# Nothing is dropped: the only names of duckdb_settings() missing from the listing are aliases of listed
# options, which the listing leaves out and zig_cookbook_option() resolves. The total is that of the pinned
# DuckDB build; update it when the pin moves.
query T
SELECT string_agg(s.name, ',' ORDER BY s.name) FROM duckdb_settings() s WHERE s.name NOT IN (SELECT name FROM zig_cookbook_options())
----
memory_limit,null_order,profile_output,streaming_buffer_size,user,wal_autocheckpoint,worker_threads

query I
SELECT count(*) FROM zig_cookbook_options()
----
201

# Aliases: those the listing reports that duckdb_settings() knows are exactly the names it lists but the
# listing does not (hidden options have aliases of their own, which duckdb_settings() does not show). No
# option of the pinned build has two aliases, so the comma between aliases is not exercised by real data.
query T
SELECT string_agg(a, ',' ORDER BY a) FROM (SELECT unnest(string_split(aliases, ',')) a FROM zig_cookbook_options() WHERE aliases <> '') WHERE a IN (SELECT name FROM duckdb_settings())
----
memory_limit,null_order,profile_output,streaming_buffer_size,user,wal_autocheckpoint,worker_threads

query TT
SELECT name, aliases FROM zig_cookbook_options() WHERE aliases LIKE '%wal_autocheckpoint%' OR aliases LIKE '%worker_threads%' ORDER BY name
----
checkpoint_threshold
wal_autocheckpoint
threads
worker_threads

# The listing is a snapshot taken at bind, of this session's settings; the default stays the default.
query TT
SELECT setting, default_setting FROM zig_cookbook_options() WHERE name = 'default_null_order'
----
NULLS_FIRST
NULLS_LAST

query T
SELECT setting FROM zig_cookbook_options() WHERE name = 'threads'
----
2

# The target scope is reported by name; UNKNOWN is what an option without an explicit scope gets.
query T
SELECT string_agg(DISTINCT scope, ',' ORDER BY scope) FROM zig_cookbook_options()
----
GLOBAL_DEFAULT,GLOBAL_ONLY,LOCAL_DEFAULT,UNKNOWN

query T
SELECT scope FROM zig_cookbook_options() WHERE name = 'default_null_order'
----
GLOBAL_DEFAULT

# The table function is usable like any other: filter, join, repeat.
query I
SELECT count(*) FROM zig_cookbook_options() a, zig_cookbook_options() b WHERE a.name = 'threads' AND b.name = 'threads'
----
1

# ── The callbacks of a scalar call site (src/cookbook/scalar_callbacks.zig) ───────────────────────────
# DuckDB's own operators and round() are the oracle.

# Resolve types: the result type follows the argument, per call site.
query TTTTT
SELECT typeof(zig_cookbook_negate(5::TINYINT)), typeof(zig_cookbook_negate(5::SMALLINT)), typeof(zig_cookbook_negate(5)), typeof(zig_cookbook_negate(5::BIGINT)), typeof(zig_cookbook_negate(2.5::FLOAT))
----
TINYINT
SMALLINT
INTEGER
BIGINT
FLOAT

query T
SELECT typeof(zig_cookbook_negate(2.5::DOUBLE))
----
DOUBLE

query TTT
SELECT zig_cookbook_negate(5::TINYINT), zig_cookbook_negate(-2.5::DOUBLE), zig_cookbook_negate(NULL::INTEGER)
----
-5
2.5
NULL

# Over a column, with NULLs, in every supported type.
query TTTTTT
SELECT bool_and(zig_cookbook_negate(x::TINYINT) = -(x::TINYINT)), bool_and(zig_cookbook_negate(x::SMALLINT) = -(x::SMALLINT)), bool_and(zig_cookbook_negate(x::INTEGER) = -(x::INTEGER)), bool_and(zig_cookbook_negate(x::BIGINT) = -(x::BIGINT)), bool_and(zig_cookbook_negate(x::FLOAT) = -(x::FLOAT)), bool_and(zig_cookbook_negate(x::DOUBLE) = -(x::DOUBLE)) FROM range(-100, 100) t(x)
----
true
true
true
true
true
true

query II
SELECT sum(zig_cookbook_negate(i::BIGINT)), count(zig_cookbook_negate(CASE WHEN i % 7 = 0 THEN NULL ELSE i::BIGINT END)) FROM range(1, 201) t(i)
----
-20100
172

query T
SELECT sum(zig_cookbook_negate(i::DOUBLE)) FROM range(1, 4001) t(i)
----
-8002000.0

# Bind: a type that cannot be negated fails while the query is planned, with a message of our own;
# so does an overflow, while the data is read.
statement error
SELECT zig_cookbook_negate('text')
----
zig_cookbook_negate: cannot negate a value of type VARCHAR

statement error
SELECT zig_cookbook_negate(DATE '2020-01-01')
----
zig_cookbook_negate: cannot negate a value of type DATE

statement error
SELECT zig_cookbook_negate(-127::TINYINT - 1::TINYINT)
----
Overflow in negation of TINYINT (-128)

statement error
SELECT zig_cookbook_negate(CASE WHEN i = 150 THEN -9223372036854775807 - 1 ELSE i END) FROM range(1, 200) t(i)
----
Overflow in negation of BIGINT (-9223372036854775808)

# Bind: the constant argument is read once. DuckDB's round() is the oracle, on halves and on thirds.
query TTTT
SELECT zig_cookbook_round_to(3.14159::DOUBLE, 2), zig_cookbook_round_to(2.5::DOUBLE, 0), zig_cookbook_round_to(-2.5::DOUBLE, 0), zig_cookbook_round_to(1234.5678::DOUBLE, 1)
----
3.14
3.0
-3.0
1234.6

query TT
SELECT bool_and(zig_cookbook_round_to(x / 8.0, 2) = round(x / 8.0, 2)), bool_and(zig_cookbook_round_to(x / 7.0, 3) = round(x / 7.0, 3)) FROM range(-4000, 4000) t(x)
----
true
true

query I
SELECT count(zig_cookbook_round_to(CASE WHEN i % 4 = 0 THEN NULL ELSE i / 3.0 END, 1)) FROM range(1, 201) t(i)
----
150

query T
SELECT zig_cookbook_round_to(1.5::DOUBLE, NULL) IS NULL
----
true

# A digits that is not constant is refused at bind time, in our words; so is one out of range.
statement error
SELECT zig_cookbook_round_to(x, d) FROM (VALUES (1.5::DOUBLE, 1)) t(x, d)
----
zig_cookbook_round_to: digits must be a constant, not a column

statement error
SELECT zig_cookbook_round_to(1.5::DOUBLE, 99)
----
zig_cookbook_round_to: digits must be between 0 and 15, got 99

query T
SELECT zig_cookbook_round_to(1.25::DOUBLE, 15)
----
1.25

statement error
SELECT zig_cookbook_round_to(1.5::DOUBLE, 16)
----
zig_cookbook_round_to: digits must be between 0 and 15, got 16

statement error
SELECT zig_cookbook_round_to(1.5::DOUBLE, -1)
----
zig_cookbook_round_to: digits must be between 0 and 15, got -1

# User data: one exec callback, three functions.
query TTTT
SELECT zig_cookbook_times2(21), zig_cookbook_times3(7), zig_cookbook_times10(-4), zig_cookbook_times10(NULL)
----
42
21
-40
NULL

query III
SELECT sum(zig_cookbook_times2(i)), sum(zig_cookbook_times3(i)), sum(zig_cookbook_times10(i)) FROM range(1, 101) t(i)
----
10100
15150
50500

statement error
SELECT zig_cookbook_times10(9223372036854775807)
----
Overflow in multiplication of INT64 (9223372036854775807 * 10)!

# Init data and a property: one counter per worker and call site, so with one thread it counts 1, 2, 3, ... over
# all chunks of the query; VOLATILE keeps DuckDB from evaluating the argument-less call once.
statement ok
SET threads = 1

query IIII
SELECT min(n), max(n), count(DISTINCT n), count(*) FROM (SELECT zig_cookbook_row_number() AS n FROM range(5000))
----
1
5000
5000
5000

query T
SELECT bool_and(n = i + 1) FROM (SELECT i, zig_cookbook_row_number() AS n FROM range(5000) t(i))
----
true

# Two call sites in one query have a counter each.
query III
SELECT zig_cookbook_row_number(), zig_cookbook_row_number(), i FROM range(3) t(i)
----
1
1
0
2
2
1
3
3
2

# The counter starts again with the next query.
query I
SELECT max(zig_cookbook_row_number()) FROM range(10)
----
10
