# Every leaf type (TINYINT .. DOUBLE, BOOLEAN, VARCHAR), a LIST(VARCHAR), a STRUCT and an INTEGER[2], six rows
# with a flush after the first row and two after the fifth (the second with nothing buffered), each column
# read back as text. The batch after the first flush is longer than the one flushed, which is what needs the
# chunk sized back up.
query T
SELECT zig_v2_appender_types_test()
----
