# An aggregate with ORDER BY inside is finalized in batches into the middle of the output vector (the result offset
# is not zero), unlike an unordered one. More than one vector of groups for each shape of result: a plain number,
# a number or NULL, text or NULL.

query T
SELECT md5(string_agg(g || ':' || s, ',' ORDER BY g)) FROM (SELECT i % 3000 AS g, zig_v2_agg_sum_ct(i ORDER BY i) AS s FROM generate_series(1, 12000) t(i) GROUP BY g)
----
78ec6c67837435c8e9b28571d492ad84

query T
SELECT md5(string_agg(g || ':' || coalesce(a::VARCHAR, '-'), ',' ORDER BY g)) FROM (SELECT i % 3000 AS g, zig_v2_weighted_avg_ct(i::DOUBLE, CASE WHEN i % 3000 % 7 = 0 THEN 0.0 ELSE 1.0 END ORDER BY i) AS a FROM generate_series(1, 12000) t(i) GROUP BY g)
----
784bd3238881cb37aeccc288a4c064e4

query T
SELECT md5(string_agg(g || ':' || coalesce(m, '-'), ',' ORDER BY g)) FROM (SELECT i % 3000 AS g, zig_v2_1brc_stats_ct(CASE WHEN i % 3000 % 5 = 0 THEN NULL ELSE ((i * 37) % 1999) / 4.0 - 250.0 END ORDER BY i) AS m FROM generate_series(1, 12000) t(i) GROUP BY g)
----
0335f261f11fbfd40aae1a5facfc3735

# Parameter names: the ones given to FunctionNamed (gram3), otherwise a0, a1, ... in order.
query TT
SELECT function_name, array_to_string(parameters, ',') FROM duckdb_functions() WHERE function_name IN ('zig_v2_gram3_ct', 'zig_v2_agg_sum_ct', 'zig_v2_weighted_avg_ct', 'zig_v2_arg_max_ct') ORDER BY function_name
----
zig_v2_agg_sum_ct
a0
zig_v2_arg_max_ct
a0,a1
zig_v2_gram3_ct
x1,x2,x3
zig_v2_weighted_avg_ct
a0,a1

# A short VARCHAR result (up to 12 bytes, stored inline) is a value like any other: it compares, hashes, groups,
# sorts and joins as the same text does. The bytes after the text used to be uninitialised, so it did none of that.
query TTTT
SELECT zig_v2_last_seen_ct(s) = 'short', zig_v2_last_seen_ct(s) = 'shorX', zig_v2_last_seen_ct(s) < 'zzz', hash(zig_v2_last_seen_ct(s)) = hash('short') FROM (VALUES ('short')) t(s)
----
true
false
true
true

query TT
SELECT zig_v2_last_seen_ct('') = '', zig_v2_last_seen_ct('x') = 'x'
----
true
true

# The boundary: 12 bytes are inline, 13 are behind a pointer.
query TT
SELECT zig_v2_last_seen_ct('123456789012') = '123456789012', zig_v2_last_seen_ct('1234567890123') = '1234567890123'
----
true
true

query T
SELECT zig_v2_1brc_stats_ct(t) = '1.0/1.0/1.0' FROM (VALUES (1.0)) t(t)
----
true

query I
SELECT count(DISTINCT a) FROM (SELECT i % 50 AS g, zig_v2_last_seen_ct('ab') AS a FROM range(1000) t(i) GROUP BY g)
----
1

query T
SELECT string_agg(a, ',' ORDER BY a) FROM (SELECT i % 3 AS g, zig_v2_last_seen_ct(CASE i % 3 WHEN 0 THEN 'cc' WHEN 1 THEN 'a' ELSE 'bbb' END) AS a FROM range(30) t(i) GROUP BY g)
----
a,bbb,cc

query I
SELECT count(*) FROM (SELECT zig_v2_last_seen_ct(CASE i % 3 WHEN 0 THEN 'cc' WHEN 1 THEN 'a' ELSE 'bbb' END) AS a FROM range(30) t(i) GROUP BY i % 3) r JOIN (VALUES ('a'), ('bbb'), ('cc'), ('zzz')) k(v) ON r.a = k.v
----
3

# ── Appender (comptime_appender_v2) ──
# Each of the first three builds rows with the Appender, takes the collection it hands back, scans it and
# formats what it read; the text is the whole of what is checked, and it covers: BIGINT, VARCHAR and DOUBLE
# columns, and a second Appender filled with 2500 rows, which flushes its chunk twice (2048 + 452) through the
# same scratch chunk; a LIST(BIGINT) and a STRUCT column; a DOUBLE[3] ARRAY and an ENUM column.

query T
SELECT zig_v2_appender_test()
----
1:alice:1.50|2:bob:2.75|3:carol:-4.00|stress:2500

query T
SELECT zig_v2_appender_nested_test()
----
[1,2,3]:(1.5,2.5)|[]:(-1.0,0.0)

query T
SELECT zig_v2_appender_array_enum_test()
----
[1.5,2.5,3.5]:active|[4.0,5.0,6.0]:done

query II
SELECT count(DISTINCT zig_v2_appender_test()), count(*) FROM range(1000)
----
1
1000

query TI
SELECT zig_v2_appender_test() = zig_v2_appender_test(), length(zig_v2_appender_test())
----
true
49


# zig_v2_nethogs_trace pushes the rows a subprocess prints through an Appender and returns them as a table. The
