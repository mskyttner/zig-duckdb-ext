query TI
SELECT (zig_v2_person_birthday_ct({'name': 'Al', 'age': 41::BIGINT})).name, (zig_v2_person_birthday_ct({'name': 'Al', 'age': 41::BIGINT})).age
----
Al
42

query T
SELECT (zig_v2_person_birthday_ct({'name': 'a name that is longer than twelve bytes', 'age': 1::BIGINT})).name
