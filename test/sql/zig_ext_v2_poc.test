cast failed

# ── aggregates (comptime_aggregate_v2) ──
# Ungrouped inputs of 100000 rows span many chunks and are combined across threads; grouped ones go through
# the per-row update. Orders that cannot be guaranteed (last seen, string_agg) are only checked where they
# are: a constant per group, or ORDER BY inside the aggregate. Results that depend on summation order use
# integer-valued doubles so they are exact.


# zig_v2_agg_sum_ct (BIGINT -> BIGINT): additive combine; NULL rows are skipped; no rows is the initial state

query I
SELECT zig_v2_agg_sum_ct(i) FROM generate_series(1, 100000) t(i)
----
5000050000

query I
SELECT zig_v2_agg_sum_ct(i) FROM generate_series(1, 10) t(i) WHERE false
----
0

query I
SELECT zig_v2_agg_sum_ct(CASE WHEN i % 3 = 0 THEN NULL ELSE i END) FROM generate_series(1, 10) t(i)
----
37

query I
SELECT zig_v2_agg_sum_ct(NULL::BIGINT) FROM generate_series(1, 10) t(i)
----
0

query I
SELECT zig_v2_agg_sum_ct(CASE WHEN i % 3 = 0 OR i % 5 = 0 THEN NULL ELSE i END) FROM generate_series(1, 100000) t(i)
----
2666633332

query T
SELECT md5(string_agg(g || ':' || s, ',' ORDER BY g)) FROM (SELECT i % 7 AS g, zig_v2_agg_sum_ct(i) AS s FROM generate_series(1, 100000) t(i) GROUP BY g)
----
6da713082233d9fce81650a3a1f62082

query II
SELECT count(*), sum(s) FROM (SELECT i % 5000 AS g, zig_v2_agg_sum_ct(i) AS s FROM generate_series(1, 100000) t(i) GROUP BY g)
----
5000
5000050000


