# Many groups over several vectors, against DuckDB's own sum().
query T
SELECT bool_and(a = b) AND count(*) = 97 FROM (SELECT zig_v2_agg_sum(CASE WHEN i % 5 = 0 THEN NULL ELSE i END) AS a, sum(CASE WHEN i % 5 = 0 THEN NULL ELSE i END)::BIGINT AS b FROM generate_series(1, 20000) t(i) GROUP BY i % 97)
----
true

query I
SELECT zig_v2_weighted_avg_part_ct(x, w) FROM (VALUES (1.0, 1.0), (2.0, 3.0), (NULL, 5.0), (7.0, NULL)) t(x, w)
----
1.75

query I
SELECT zig_v2_weighted_avg_part_ct(x, w) FROM (VALUES (1.0, 0.0), (2.0, 0.0)) t(x, w)
----
NULL

# Grouped, with NULLs in either argument and zero weights, against DuckDB's own sums.
query T
WITH d AS (SELECT i % 7 AS g, CASE WHEN i % 5 = 0 THEN NULL ELSE i::DOUBLE END AS x, CASE WHEN i % 11 = 0 THEN NULL ELSE (i % 3)::DOUBLE END AS w FROM generate_series(1, 10000) t(i))
SELECT count(*) = 7 AND bool_and(abs(a.v - b.v) < 1e-9) FROM (SELECT g, zig_v2_weighted_avg_part_ct(x, w) AS v FROM d GROUP BY g) a JOIN (SELECT g, sum(x * w) / sum(w) FILTER (WHERE x IS NOT NULL AND w IS NOT NULL) AS v FROM d GROUP BY g) b USING (g)
----
true

