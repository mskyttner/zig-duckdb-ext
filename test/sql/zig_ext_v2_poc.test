----
31cd9ebc2ec4fb962cf65f6f5e5d2e87

query T
SELECT md5(CAST(zig_v2_matmul_ct(list_transform(range(340), lambda x: (x % 7)::DOUBLE), list_transform(range(323), lambda x: ((x * 3) % 5)::DOUBLE), 20, 17, 19) AS VARCHAR))
