query II
SELECT count(zig_v2_double(CASE WHEN i % 7 = 0 THEN NULL ELSE i END)), sum(zig_v2_double(CASE WHEN i % 7 = 0 THEN NULL ELSE i END)) FROM generate_series(1, 200) t(i)
----
172
34516

