a name that is longer than twelve bytes

query I
SELECT (zig_v2_person_birthday_ct(NULL)).age
----
NULL

query T
SELECT md5(string_agg((zig_v2_person_birthday_ct({'name': 'n' || i::VARCHAR, 'age': i::BIGINT})).name || '/' || (zig_v2_person_birthday_ct({'name': 'n' || i::VARCHAR, 'age': i::BIGINT})).age, ',' ORDER BY i)) FROM generate_series(1, 2500) t(i)
----
1455e8e41e860e8c24626c8ff60e1f10

# ── VARIANT: a NULL argument is data, not a skipped row ──

query T
SELECT CAST(zig_v2_variant_default_ct(CAST(42::BIGINT AS VARIANT), 7) AS VARCHAR)
----
42

query T
SELECT CAST(zig_v2_variant_default_ct(CAST(NULL AS VARIANT), 7) AS VARCHAR)
----
7

# The VARIANT argument is data, but a NULL in any other argument still skips the row.
query T
SELECT CAST(zig_v2_variant_default_ct(CAST(42::BIGINT AS VARIANT), NULL) AS VARCHAR)
----
NULL

query T
SELECT CAST(zig_v2_variant_default_ct(CAST(NULL AS VARIANT), NULL) AS VARCHAR)
----
NULL

query T
SELECT string_agg(coalesce(CAST(zig_v2_variant_default_ct(CAST(i AS VARIANT), CASE WHEN i % 3 = 0 THEN NULL ELSE 100 END) AS VARCHAR), '-'), ',' ORDER BY i) FROM generate_series(1, 6) t(i)
----
1,2,-,4,5,-

