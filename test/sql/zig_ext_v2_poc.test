# name: test/sql/zig_ext_v2_poc.test
# description: Behavior of the comptime scalar and table frameworks, through the v2 proof-of-concept extension
# group: [zig_ext_v2_poc]
#
# The proof-of-concept extension is where the frameworks' broadest coverage lives (STRUCT, LIST, ARRAY,
# MAP, UNION, DECIMAL, ENUM, VARIANT, BLOB, pushdown, ...); the real extension uses only a few of them.
# Results that are big or nested are compared by md5() of an aggregated string whose expected value was
# computed independently of the extension; small ones are written out.
#
statement ok
SET allow_extensions_metadata_mismatch=true

require zig_ext_v2_poc

# ── numeric scalars ──

query I
SELECT zig_v2_triple(4)
----
12

query I
SELECT zig_v2_triple(NULL)
----
NULL

query I
SELECT zig_v2_triple(i) FROM generate_series(1, 3) t(i)
----
3
6
9

query I
SELECT zig_v2_add(3, 4)
----
7

query I
SELECT zig_v2_add(NULL, 4)
----
NULL

query I
SELECT zig_v2_add(3, NULL)
----
NULL

# More rows than one DuckDB vector (2048) holds, with NULLs on either side.

query II
SELECT count(*), sum(zig_v2_add(i, 1)) FROM generate_series(1, 5000) t(i)
----
5000
12507500

query II
SELECT count(zig_v2_add(CASE WHEN i % 3 = 0 THEN NULL ELSE i END, CASE WHEN i % 5 = 0 THEN NULL ELSE i END)), sum(zig_v2_add(CASE WHEN i % 3 = 0 THEN NULL ELSE i END, CASE WHEN i % 5 = 0 THEN NULL ELSE i END)) FROM generate_series(1, 5000) t(i)
----
2667
13336664

query R
SELECT zig_v2_narrow_sum_ct(1::TINYINT, 2::SMALLINT, 3::INTEGER, 0.5::FLOAT)
----
6.5

query R
SELECT zig_v2_narrow_sum_ct(-100::TINYINT, 1000::SMALLINT, 100000::INTEGER, -0.25::FLOAT)
----
100899.75

query R
SELECT zig_v2_narrow_sum_ct(NULL, 2::SMALLINT, 3::INTEGER, 0.5::FLOAT)
----
NULL

# ── VARCHAR ──

query T
SELECT zig_v2_first_char_ct('hello')
----
h

query T
SELECT zig_v2_first_char_ct('')
----
(empty)

query T
SELECT zig_v2_first_char_ct(NULL)
----
NULL

query T
SELECT zig_v2_first_char_ct('a string that is longer than the twelve bytes DuckDB inlines')
----
a

query T
SELECT string_agg(coalesce(zig_v2_first_char_ct(s), '-'), '' ORDER BY ord) FROM (VALUES (0, 'alpha'), (1, ''), (2, 'beta'), (3, NULL), (4, 'gamma delta epsilon zeta eta theta')) t(ord, s)
----
ab-g

