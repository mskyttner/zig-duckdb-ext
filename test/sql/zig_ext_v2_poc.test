----
1
NULL
NULL
9

query T
SELECT md5(string_agg(coalesce(TRY_CAST(w AS BIGINT)::VARCHAR, '-'), ',' ORDER BY ord)) FROM (SELECT i AS ord, CASE WHEN i % 13 = 0 THEN 'zzz' WHEN i % 7 = 0 THEN 'three' WHEN i % 5 = 0 THEN 'five' ELSE i::VARCHAR END AS w FROM generate_series(1, 5000) t(i))
----
88a3e9dff2c73a0ca7ef40da14677e09

# A custom ENUM cast is not limited to its own dictionary (see comptime_cast_v2.zig): the VARCHAR -> ENUM
# cast, which only knows the PoC's mood names, is applied to this ENUM too.
statement error
SELECT CAST(CAST('a' AS ENUM('a','b','c')) AS BIGINT)
