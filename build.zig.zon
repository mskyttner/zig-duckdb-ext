.{
    // This is the default name used by packages depending on this one. For
    // example, when a user runs `zig fetch --save <url>`, this field is used
    // as the key in the `dependencies` table. Although the user can choose a
    // different name, most users will stick with this provided value.
    //
    // It is redundant to include "zig" in this name because it is already
    // within the Zig package namespace.
    .name = .zig_duckdb_ext,
    // This is a [Semantic Version](https://semver.org/).
    // In a future version of Zig it will be used for package deduplication.
    .version = "0.0.0",
    // Together with name, this represents a globally unique package
    // identifier. This field is generated by the Zig toolchain when the
    // package is first created, and then *never changes*. This allows
    // unambiguous detection of one package being an updated version of
    // another.
    //
    // When forking a Zig project, this id should be regenerated (delete the
    // field and run `zig build`) if the upstream project is still maintained.
    // Otherwise, the fork is *hostile*, attempting to take control over the
    // original project's identity. Thus it is recommended to leave the comment
    // on the following line intact, so that it shows up in code reviews that
    // modify the field.
    .fingerprint = 0x7f8fc898459a6be7, // Changing this has security and trust implications.
    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.16.0",
    // This field is optional.
    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package, recursively.
    // Once all dependencies are fetched, `zig build` no longer requires
    // internet connectivity.
    .dependencies = .{
        // An archive of the commit rather than `git+https://…#<commit>`: the same tree (the same hash, checked), but one HTTP
        // download instead of the git protocol's capability discovery and pack fetch, whose failure mode in CI was a
        // `NameServerFailure` on the first step. Not lazy, although only the v1 build and the header translation use it:
        // build.zig imports its module (`@import("translate_c")`), and a build script cannot import a lazy dependency.
        .translate_c = .{
            .url = "https://codeberg.org/ziglang/translate-c/archive/875969d3493e245e01bf5d7860f792d8f3eb9ef5.tar.gz",
            .hash = "translate_c-0.0.0-Q_BUWoFOBwAhz77Zd15HCVuhTKzdUKc94kezmCeJ7IC_",
        },
        // Pinned, content-hashed DuckDB v2.0 CLI binaries — replaces
        // the machine-local, unpinned `DUCKDB_VERSION=alpha bash
        // <(curl https://install.duckdb.org)` install this project's own
        // docs (docs/v2-migration-plan.md's "Testing infrastructure gaps")
        // previously required by hand, for the two host platforms this
        // repo builds/tests on. `lazy = true` so only the one matching the
        // build host is ever actually fetched (see `duckdbV2CliLazyPath`
        // in build.zig); the other stays undownloaded.
        //
        // RESOLVED, 2026-10-22: `v2.0.0` ("Cyanoptera") is now a real,
        // non-draft, non-prerelease tagged GitHub release (`gh api
        // repos/duckdb/duckdb/releases/tags/v2.0.0`, published
        // 2026-10-21), confirmed to target exactly commit `d54cbbe3df`
        // (`target_commitish` in that same API response) — the commit
        // this project had already pinned via the staging mirror below.
        // Re-pinned to the permanent `github.com/duckdb/duckdb/releases/
        // download/v2.0.0/...` URLs the earlier caveats here said to
        // switch to once a tagged release existed. The content hashes
        // below are unchanged: `zig fetch` against each new URL produced
        // the identical hash already recorded (byte-for-byte the same
        // artifact as the staging mirror served, confirmed live for all
        // five assets this project fetches from this release), so no
        // bindings regeneration or re-verification of the test suite was
        // needed — only the URLs moved.
        //
        // Prior pin history, for reference: staged at
        // `duckdb-staging.duckdb.org/d54cbbe3df/v2.0.0/duckdb/duckdb/
        // github_release/...` (confirmed, 2026-10-16, to be exactly the
        // shape `duckdb/duckdb-install-scripts`' own `install.sh` hits for
        // `DUCKDB_STAGED=<commit>/<version>`) — itself reached not via the
        // floating `artifacts.duckdb.org/staged/v2.0-cyanoptera/...` alias
        // this was originally pinned via (that alias pointed at a
        // differently-labeled, differently-hashed staged build,
        // `d54cbbe3df/v2.0.0-alpha49225`, confirmed live 2026-10-21 to
        // still disagree even after the real release shipped — the alias
        // was never meant to track the tagged release). Earlier pins
        // before that: `f8f3f4dcd9`/`v2.0.0-alpha48730` and
        // `b15358c371`/`v2.0.0-alpha46057`.
        .duckdb_cli_v2_linux_amd64 = .{
            .url = "https://github.com/duckdb/duckdb/releases/download/v2.0.0/duckdb-cli-linux-amd64.tar.gz",
            .hash = "N-V-__8AADj2ngSI3vX6n2jU0wwwn19lzCioODSBEWMre_ZJ",
            .lazy = true,
        },
        .duckdb_cli_v2_linux_arm64 = .{
            .url = "https://github.com/duckdb/duckdb/releases/download/v2.0.0/duckdb-cli-linux-arm64.tar.gz",
            .hash = "N-V-__8AAHjSfATfl4KE0emz5vLpo7k7Y8fV6BF3bkzNnwCY",
            .lazy = true,
        },
        // Version-pinned, content-hashed vendored DuckDB C API headers —
        // replaces the plain committed `duckdb_capi/*.h` files, which had
        // no recorded provenance (confirmed, 2026-10-13: byte-for-byte
        // identical to neither the v1.2.0 tag their own `const
        // target_duckdb_version` suggested, nor v1.3.0 through v1.5.6, nor
        // `main` — origin unknown). Re-vendored from DuckDb's own
        // `libduckdb-src.zip` release/CI artifact (small — a few hundred KB
        // to 5MB, not a full source clone — and a format `zig fetch`
        // recognizes; a bare `.h` file served as `text/plain` is not, so
        // that was tried first and rejected). Full build + `task
        // check:all` + `zig build cross` + the 53-block v1 sqllogictest
        // suite all re-verified passing against these exact fetched files
        // before switching to them.
        //
        // v1: the real, tagged `v1.5.6` release — matches every other v1
        // version reference already in this project (the GitHub Actions
        // release workflow's `DUCKDB_VERSION`, the CLI used for manual/
        // sqllogictest verification throughout this branch). Immutable:
        // a tagged release's assets never change, so this hash never goes
        // stale.
        .duckdb_headers_v1 = .{
            .url = "https://github.com/duckdb/duckdb/releases/download/v1.5.6/libduckdb-src.zip",
            .hash = "N-V-__8AANq4rwEjjrNWz619N1Pu61lS5GAi7o4Qx9cHU7aN",
        },
        // v2: the real, tagged `v2.0.0` release, commit `d54cbbe3df` — see
        // the `duckdb_cli_v2_*` entries above for the 2026-10-22
        // resolution (tag confirmed, content hash unchanged from the
        // staging pin this replaced).
        .duckdb_headers_v2 = .{
            .url = "https://github.com/duckdb/duckdb/releases/download/v2.0.0/libduckdb-src.zip",
            .hash = "N-V-__8AAAMVFQBoV63YG3t4d_XYQ813sZwDyKSE6f-eovyC",
        },
        // A real, compiled `libduckdb_static.a` (+ matching full headers)
        // for the exact same pinned `v2.0.0` commit — contrary
        // to `docs/v2-migration-plan.md`'s "Static linking" section's
        // earlier "confirmed absent" finding, which checked the wrong
        // filename (the real v1.5.6 GitHub-release naming convention,
        // `libduckdb-linux-amd64.zip`/`static-libs-linux-amd64.zip`, both
        // genuinely 404 here). The staged channel uses a different,
        // `duckdb-`-prefixed naming scheme instead
        // (`duckdb-static-libs-linux-amd64.tar.gz`), confirmed live to
        // return 200 with a real static archive — verified it's really
        // for this exact pinned commit/version by `strings`-ing
        // `libcore_functions_extension.a` for its embedded version string
        // (plain `v2.0.0`), not just trusting the URL path.
        // `lazy = true`: only the `v2-static-embed-poc` step (itself
        // experimental, not part of any default build) ever fetches
        // this — large and single-purpose. Pinned via the real tagged
        // `v2.0.0` release now — see `duckdb_cli_v2_*` above.
        .duckdb_static_libs_v2_linux_amd64 = .{
            .url = "https://github.com/duckdb/duckdb/releases/download/v2.0.0/duckdb-static-libs-linux-amd64.tar.gz",
            .hash = "N-V-__8AAEQMEws0Kz5i4m88XTVpwG4bpBD_O4wjeT6bFETr",
            .lazy = true,
        },
        // The same static libraries for Windows, built with MinGW (GCC 10.4, libstdc++) — NOT the plain
        // `duckdb-static-libs-windows-amd64` tarball, which is an MSVC build (`.lib`, 206 MB). Only the
        // `v2-static-embed-poc` steps ever fetch it, when built with `-Dtarget=x86_64-windows-gnu`.
        .duckdb_static_libs_v2_windows_mingw = .{
            .url = "https://github.com/duckdb/duckdb/releases/download/v2.0.0/duckdb-static-libs-windows-mingw.tar.gz",
            .hash = "N-V-__8AACwVvQpNi6g3ansv5W37gY6A4SPVNXcStlcs1cBz",
            .lazy = true,
        },
        // YAML parser, needed only by tools/gen_v2_bindings.zig, which
        // regenerates src/lib/duckdb_v2_{types,static,dynamic}.zig from the API spec
        // (`zig build gen-v2-bindings`). The spec uses block scalars and flow
        // maps, which upstream kubkon/zig-yaml does not parse — pinned to a
        // fork (`mskyttner/zig-yaml`'s `master` branch) carrying those
        // additions instead of the local `../zig-yaml` path this was
        // originally developed against (see ADR-0007). `lazy = true`, so no
        // other build ever resolves it — the generated files are committed.
        .yaml = .{
            .url = "git+https://codeberg.org/mskyttner/zig-yaml#09ae7053845155aa14dbe0322bd21c7b07e536fe",
            .hash = "zig_yaml-0.3.0-C1161rsbAwCYmeiMgf7MzPUqg0AeV0I4GAdml-do4Iko",
            .lazy = true,
        },
        // Image decode/resize, needed only by src/lib/braille_image.zig —
        // a speculative v2-poc-only demo (a scalar + table function, plus
        // a replacement scan for `FROM 'https://.../*.jpg'`), never wired
        // into the real zig_ext/zig_ext_v2 extensions. `lazy = true` so a
        // plain `zig build`/`zig build cross` never fetches it. Same pin
        // the sibling ../braille_image project already uses.
        .zignal = .{
            .url = "git+https://github.com/arrufat/zignal#56586a9ae1537661033c2475185d984da0d88b75",
            .hash = "zignal-0.11.0-dev-OrZ3s2R2KgBB2VYMukzzVm2viQ8UBwnYIBXVbaTZ7M8M",
            .lazy = true,
        },
        // OpenCV-bit-exact kernels, needed only by the weighted-Voronoi-
        // stippling v2-poc demo (src/lib/stipple_image.zig) for its
        // Gaussian-blur pre-smoothing step — a separate, isolated demo
        // from the braille one above, so its own dependency stays lazy
        // and doesn't affect anything else. `blurU8`/`blurF32` take raw
        // slices (no zigcv-specific image type), directly compatible
        // with a `zignal.Image(u8)`'s own `.data` field — confirmed via
        // zigcv's own README ("decode to an 8-bit grey or RGB slice and
        // hand it to zigcv") and `src/gauss.zig`'s actual signatures.
        //
        // Pinned via `git+...#<commit>` (tag v0.18.0's exact commit),
        // NOT the `archive/refs/tags/*.tar.gz` URL this was originally
        // pinned with — confirmed live that GitHub's auto-generated tag
        // tarballs are not reliably byte-reproducible across separate
        // downloads (repeated `zig fetch` of the identical tag URL
        // produced two different content hashes, which then made
        // `b.dependency(...).module("zigcv")` fail with "unable to find
        // module" — the fetched package's `build()` never ran against
        // the hash this manifest expected). `git+...#<commit>` is
        // content-addressed by git itself and reproducible, same
        // convention already used for `zignal` above.
        .zigcv = .{
            .url = "git+https://github.com/mgbilby/zigcv#44a4306dfdc061d11ba99b9f517fe1f9e5a18ebd",
            .hash = "zigcv-0.18.0-rNqqFhl8BABuG4b4Ve8vmxxUOmy9KlXiBTVZYliWYo3v",
            .lazy = true,
        },
        // Work-stealing coroutine async-I/O runtime, needed only by the v2-poc
        // `zig_v2_matmul_bench_io_ct` demo (src/ext/init_v2_poc_zio.zig) — a second `std.Io`
        // backend tried against `matmul.matmulSimdParallel` alongside `std.Io.Threaded`, since
        // `matmulSimdParallel` is written against `std.Io` generically and zio's own README
        // claims code written against `std.Io` "runs on zio unmodified." `lazy = true`, same
        // full-isolation reasoning as `zignal`/`zigcv` above: the only place in the project
        // pulling this in, so nothing else is affected if it fails to fetch or build. Pinned to
        // main's HEAD at the time this was added (no tagged release covers Zig 0.17 yet).
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio#e6e7b546f135bf50a3757f78994fd7edfa2fac60",
            .hash = "zio-0.19.0-xHbVVBk2LQC-Vxp1X6o0y0rI0qGck1Uy2ctsd-kQoHR8",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // For example...
        //"LICENSE",
        //"README.md",
    },
}
