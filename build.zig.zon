.{
    // This is the default name used by packages depending on this one. For
    // example, when a user runs `zig fetch --save <url>`, this field is used
    // as the key in the `dependencies` table. Although the user can choose a
    // different name, most users will stick with this provided value.
    //
    // It is redundant to include "zig" in this name because it is already
    // within the Zig package namespace.
    .name = .zig_duckdb_ext,
    // This is a [Semantic Version](https://semver.org/).
    // In a future version of Zig it will be used for package deduplication.
    .version = "0.0.0",
    // Together with name, this represents a globally unique package
    // identifier. This field is generated by the Zig toolchain when the
    // package is first created, and then *never changes*. This allows
    // unambiguous detection of one package being an updated version of
    // another.
    //
    // When forking a Zig project, this id should be regenerated (delete the
    // field and run `zig build`) if the upstream project is still maintained.
    // Otherwise, the fork is *hostile*, attempting to take control over the
    // original project's identity. Thus it is recommended to leave the comment
    // on the following line intact, so that it shows up in code reviews that
    // modify the field.
    .fingerprint = 0x7f8fc898459a6be7, // Changing this has security and trust implications.
    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.16.0",
    // This field is optional.
    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package, recursively.
    // Once all dependencies are fetched, `zig build` no longer requires
    // internet connectivity.
    .dependencies = .{
        .translate_c = .{
            .url = "git+https://codeberg.org/ziglang/translate-c#875969d3493e245e01bf5d7860f792d8f3eb9ef5",
            .hash = "translate_c-0.0.0-Q_BUWoFOBwAhz77Zd15HCVuhTKzdUKc94kezmCeJ7IC_",
        },
        // Pinned, content-hashed DuckDB v2.0 alpha CLI binaries — replaces
        // the machine-local, unpinned `DUCKDB_VERSION=alpha bash
        // <(curl https://install.duckdb.org)` install this project's own
        // docs (docs/v2-migration-plan.md's "Testing infrastructure gaps")
        // previously required by hand, for the two host platforms DuckDB
        // actually publishes a CLI for at this staged URL today (confirmed
        // live, 2026-10-12: macOS/Windows return 404 here — only Linux
        // amd64/arm64 exist under this path). `lazy = true` so only the
        // one matching the build host is ever actually fetched (see
        // `duckdbV2CliLazyPath` in build.zig); the other stays undownloaded.
        //
        // CAUTION: this is a *staged*, not a tagged-release, artifact — the
        // URL tracks whatever's most recently published under the
        // "cyanoptera" codename, so these hashes WILL need re-pinning
        // (`zig fetch <url>`) whenever that staged build moves forward,
        // until DuckDB 2.0 ships as a real tagged release and this switches
        // to the immutable `github.com/duckdb/duckdb/releases/download/...`
        // pattern already used for the v1.5.6 headers.
        .duckdb_cli_v2_linux_amd64 = .{
            .url = "https://artifacts.duckdb.org/staged/v2.0-cyanoptera/duckdb-cli-linux-amd64.tar.gz",
            .hash = "N-V-__8AAOgVkwSHK16ZpcdwJyoQE2HdKzvZD27NNylVyxks",
            .lazy = true,
        },
        .duckdb_cli_v2_linux_arm64 = .{
            .url = "https://artifacts.duckdb.org/staged/v2.0-cyanoptera/duckdb-cli-linux-arm64.tar.gz",
            .hash = "N-V-__8AAIiicQTh1HPr3MiDX9aKnSfL103zk5phspO7cTtP",
            .lazy = true,
        },
        // Version-pinned, content-hashed vendored DuckDB C API headers —
        // replaces the plain committed `duckdb_capi/*.h` files, which had
        // no recorded provenance (confirmed, 2026-10-13: byte-for-byte
        // identical to neither the v1.2.0 tag their own `const
        // target_duckdb_version` suggested, nor v1.3.0 through v1.5.6, nor
        // `main` — origin unknown). Re-vendored from DuckDb's own
        // `libduckdb-src.zip` release/CI artifact (small — a few hundred KB
        // to 5MB, not a full source clone — and a format `zig fetch`
        // recognizes; a bare `.h` file served as `text/plain` is not, so
        // that was tried first and rejected). Full build + `task
        // check:all` + `zig build cross` + the 53-block v1 sqllogictest
        // suite all re-verified passing against these exact fetched files
        // before switching to them.
        //
        // v1: the real, tagged `v1.5.6` release — matches every other v1
        // version reference already in this project (the GitHub Actions
        // release workflow's `DUCKDB_VERSION`, the CLI used for manual/
        // sqllogictest verification throughout this branch). Immutable:
        // a tagged release's assets never change, so this hash never goes
        // stale.
        .duckdb_headers_v1 = .{
            .url = "https://github.com/duckdb/duckdb/releases/download/v1.5.6/libduckdb-src.zip",
            .hash = "N-V-__8AANq4rwEjjrNWz619N1Pu61lS5GAi7o4Qx9cHU7aN",
        },
        // v2: confirmed byte-identical to the exact commit
        // (`b15358c371`) the staged `v2.0.0-alpha46057` ("Cyanoptera")
        // CLI itself reports via `-version` — not a guess, verified by
        // diffing against `raw.githubusercontent.com/.../b15358c371/...`
        // directly. Same staged-artifact caveat as the CLI dependencies
        // above: this URL tracks whatever's most recently published under
        // the "cyanoptera" codename, so this hash WILL need re-pinning
        // (`zig fetch <url>`) whenever that staged build moves forward,
        // until DuckDB 2.0 ships as a real tagged release.
        .duckdb_headers_v2 = .{
            .url = "https://artifacts.duckdb.org/staged/v2.0-cyanoptera/libduckdb-src.zip",
            .hash = "N-V-__8AAL-2EwBI2NUq5ff3_vktqJo_yWCjvSZf2a-ID-p9",
        },
        // A real, compiled `libduckdb_static.a` (+ matching full headers)
        // for the exact same pinned `v2.0.0-alpha46057` commit — contrary
        // to `docs/v2-migration-plan.md`'s "Static linking" section's
        // earlier "confirmed absent" finding, which checked the wrong
        // filename (the real v1.5.6 GitHub-release naming convention,
        // `libduckdb-linux-amd64.zip`/`static-libs-linux-amd64.zip`, both
        // genuinely 404 here). The staged alpha channel uses a different,
        // `duckdb-`-prefixed naming scheme instead
        // (`duckdb-static-libs-linux-amd64.tar.gz`), confirmed live to
        // return 200 with a real 127MB static archive — verified it's
        // really for this exact pinned commit by `strings`-ing the
        // archive's `libduckdb.so` sibling for its embedded version
        // string (`v2.0.0-alpha46057`), not just trusting the URL path.
        // `lazy = true`: only the `v2-static-embed-poc` step (itself
        // experimental, not part of any default build) ever fetches
        // this — large and single-purpose. Same staged-artifact
        // re-pinning caveat as `duckdb_cli_v2_*`/`duckdb_headers_v2`
        // above.
        .duckdb_static_libs_v2_linux_amd64 = .{
            .url = "https://artifacts.duckdb.org/staged/v2.0-cyanoptera/duckdb-static-libs-linux-amd64.tar.gz",
            .hash = "N-V-__8AABK7-Ap51O97S6GR_NBvztMr80sAma26ZeRToc7f",
            .lazy = true,
        },
        // Image decode/resize, needed only by src/lib/braille_image.zig —
        // a speculative v2-poc-only demo (a scalar + table function, plus
        // a replacement scan for `FROM 'https://.../*.jpg'`), never wired
        // into the real zig_ext/zig_ext_v2 extensions. `lazy = true` so a
        // plain `zig build`/`zig build cross` never fetches it. Same pin
        // the sibling ../braille_image project already uses.
        .zignal = .{
            .url = "git+https://github.com/arrufat/zignal#56586a9ae1537661033c2475185d984da0d88b75",
            .hash = "zignal-0.11.0-dev-OrZ3s2R2KgBB2VYMukzzVm2viQ8UBwnYIBXVbaTZ7M8M",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // For example...
        //"LICENSE",
        //"README.md",
    },
}
